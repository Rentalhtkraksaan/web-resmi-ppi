# ============================================================
# Salin file ini menjadi `.env` (lokal) DAN isi nilai yang SAMA
# di Environment Variables hosting (Vercel -> Settings -> Environment Variables)
# ============================================================

# PostgreSQL hosted (Neon / Supabase). SATU database untuk localhost & hosting.
# Contoh Neon : postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# (Opsional, jika memakai pooler) URL koneksi langsung untuk `prisma db push`
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Rahasia penanda sesi login (isi string acak panjang, harus sama di lokal & hosting)
JWT_SECRET="ganti-dengan-string-acak-panjang"

# Cloudinary (penyimpanan foto). Ambil dari Cloudinary Dashboard -> API Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# CLOUDINARY_FOLDER="ppi-probolinggo"
