# ============================================================
# Salin file ini menjadi `.env` (lokal) DAN isi nilai yang SAMA
# di Environment Variables hosting (Vercel -> Settings -> Environment Variables)
# ============================================================

# TiDB Cloud (MySQL-compatible). SATU database untuk localhost & hosting.
# Ambil dari TiDB Cloud -> cluster -> Connect -> pilih "Prisma".
# Wajib diakhiri ?sslaccept=strict . Jika password mengandung simbol (@ # / dll), URL-encode dulu.
DATABASE_URL="mysql://USER.root:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/test?sslaccept=strict&connection_limit=5"

# Rahasia penanda sesi login (isi string acak panjang, harus sama di lokal & hosting)
JWT_SECRET="ganti-dengan-string-acak-panjang"

# Cloudinary (penyimpanan foto). Ambil dari Cloudinary Dashboard -> API Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# CLOUDINARY_FOLDER="ppi-probolinggo"
